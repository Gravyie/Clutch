# Install as /etc/clutch/engine.env, chmod 600. Never commit the populated file.
RPC_URL=https://YOUR_BASE_SEPOLIA_RPC
ENGINE_PUBLIC_URL=
APP_ORIGIN=
AUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Dedicated runtime roles: use keys matching the existing on-chain agent and pass signer.
# Do NOT set OWNER_PRIVATE_KEY. Do NOT reuse the owner/deployer key here.
# Runtime Secrets Manager names in ap-south-1:
# clutch/testnet/agent-private-key
# clutch/testnet/pass-signer-private-key
AGENT_PRIVATE_KEY=
PASS_SIGNER_PRIVATE_KEY=
HOUSE_CHANNELS=
VIDEO_CHANNELS=
MAX_VIDEO_STREAMS=1
MARKET_B_USDC=80
LATENCY_BUFFER_SEC=8
TWITCH_LATENCY_BUFFER_SEC=10
VIDEO_TRADING_SEC=15
ZG_API_KEY=
ZG_ROUTER_URL=https://router-api.0g.ai/v1
ZG_MODEL=claude-haiku-5.5
ZG_VISION_MODEL=claude-haiku-5.5
ZG_VERIFY_MODEL=0gm-1.0-35b-a3b
ZG_DAILY_CAP_USD=2
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional evidence upload key is separate; enabling it can spend on 0G Storage.
ZG_STORAGE_PRIVATE_KEY=
# Configure World verification before allowing public trading.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=clutch-human-pass
WORLD_ENVIRONMENT=staging
PASS_DAILY_CAP_USDC=100
