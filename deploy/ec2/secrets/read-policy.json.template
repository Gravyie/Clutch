{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ReadOnlyPlannedClutchRuntimeKeys",
    "Effect": "Allow",
    "Action": "secretsmanager:GetSecretValue",
    "Resource": [
      "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:clutch/testnet/agent-private-key-??????",
      "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:clutch/testnet/pass-signer-private-key-??????"
    ],
    "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}
  }]
}
