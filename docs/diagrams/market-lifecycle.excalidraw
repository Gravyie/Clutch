  {
   "type": "text",
   "id": "t37",
   "x": 40,
   "y": 350,
   "width": 121.00000000000001,
   "height": 28.6,
   "text": "Guarantees",
   "originalText": "Guarantees",
   "fontSize": 22,
   "fontFamily": 1,
   "strokeColor": "#1e1e1e",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "t38",
   "x": 60,
   "y": 390,
   "width": 944.35,
   "height": 22.1,
   "text": "- No market about a moment anyone has seen: windowStart >= lockTime + latencyBuffer reverts otherwise",
   "originalText": "- No market about a moment anyone has seen: windowStart >= lockTime + latencyBuffer reverts otherwise",
   "fontSize": 17,
   "fontFamily": 1,
   "strokeColor": "#343a40",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "t39",
   "x": 60,
   "y": 422,
   "width": 729.3000000000001,
   "height": 22.1,
   "text": "- No single model decides: two model families, separate frames and connections",
   "originalText": "- No single model decides: two model families, separate frames and connections",
   "fontSize": 17,
   "fontFamily": 1,
   "strokeColor": "#343a40",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "t40",
   "x": 60,
   "y": 454,
   "width": 860.2,
   "height": 22.1,
   "text": "- No guessing: a reader with no data has no verdict, and the market voids with a full refund",
   "originalText": "- No guessing: a reader with no data has no verdict, and the market voids with a full refund",
   "fontSize": 17,
   "fontFamily": 1,
   "strokeColor": "#343a40",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "t41",
   "x": 60,
   "y": 486,
   "width": 897.6,
   "height": 22.1,
   "text": "- No insider edge: the streamer's human ID can't trade their own markets; caps follow the person",
   "originalText": "- No insider edge: the streamer's human ID can't trade their own markets; caps follow the person",
   "fontSize": 17,
   "fontFamily": 1,
   "strokeColor": "#343a40",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "t42",
   "x": 60,
   "y": 518,
   "width": 897.6,
   "height": 22.1,
   "text": "- No chain-outage edge: Blackout Guard voids markets whose trading overlapped a sequencer outage",
   "originalText": "- No chain-outage edge: Blackout Guard voids markets whose trading overlapped a sequencer outage",
   "fontSize": 17,
   "fontFamily": 1,
   "strokeColor": "#343a40",
   "autoResize": true
  }
