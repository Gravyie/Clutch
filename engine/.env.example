# Chain (defaults: local anvil, keys = anvil #1 agent, #2 pass signer, #0 faucet/streamer)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# AGENT_PRIVATE_KEY=
# PASS_SIGNER_PRIVATE_KEY=
# FAUCET_PRIVATE_KEY=

# Games: lichess-tv (live top blitz game) or replay (engine/fixtures/game.json, offline)
GAME_SOURCE=lichess-tv
LICHESS_CHANNEL=blitz
LATENCY_BUFFER_SEC=8
TRADING_SEC=18
MARKET_B_USDC=60
# TWITCH_CHANNEL=           # show a Twitch embed instead of the board; viewer latency then sets the buffer
# REPLAY_SPEED=1
# REPLAY_CORRUPT_PLY=40     # make source B misread one ply → the market VOIDs (demo)

# 0G: inference via the Router (pc.0g.ai → API key), evidence on 0G Storage
ZG_API_KEY=
ZG_MODEL=claude-haiku-5.5
ZG_ROUTER_URL=https://router-api.0g.ai/v1
ZG_DAILY_CAP_USD=2
ZG_STORAGE_PRIVATE_KEY=
ZG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# World ID (developer.world.org → app_id, rp_id, signing key). Unset = labelled dev verifier.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=clutch-human-pass
WORLD_ENVIRONMENT=staging
PASS_DAILY_CAP_USDC=100
