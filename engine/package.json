{
  "name": "@clutch/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "tsx --test src/*.test.ts",
    "agent": "tsx --env-file-if-exists=.env src/agent/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start:production": "node dist/main.mjs"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "^1.2.8",
    "@clutch/shared": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "chess.js": "^1.4.0",
    "ethers": "^6.15.0",
    "jose": "^6.2.15",
    "openai": "^7.52.0",
    "sharp": "^0.34.5",
    "viem": "^2.57.16",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "esbuild": "0.28.2"
  },
  "files": [
    "dist",
    "fixtures"
  ]
}
